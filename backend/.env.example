# LuxStore Backend Environment Variables
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/luxstore_db

# Security & Session Secrets
JWT_SECRET=luxstore_dev_super_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=luxstore_cookie_secret_dev_32_characters_long

# CORS Allowed Origins (Comma separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Store Configuration
STORE_CURRENCY=USD
FREE_SHIPPING_THRESHOLD=150
DEFAULT_TAX_RATE=0.08
